# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Auth0 Dashboard > Applications
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id

# ใส่เมื่อมี backend API แล้ว (Auth0 > APIs > Identifier) — ยังไม่มีตอนนี้ปล่อยว่างได้
VITE_AUTH0_AUDIENCE=

# backend NestJS — dev รันที่ localhost:3000
VITE_API_BASE_URL=http://localhost:3000
