PORT=3000

# Railway จะ inject ให้อัตโนมัติถ้าใช้ Postgres plugin ในโปรเจกต์เดียวกัน
DATABASE_URL="postgresql://user:password@localhost:5432/catering?schema=public"

# ต้องสร้าง API ใน Auth0 ก่อน (Applications > APIs > Create API) แล้วเอา Identifier มาใส่ AUTH0_AUDIENCE
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.pipatphochana-catering.app

# origin ของ frontend (คั่นด้วย , ได้หลายค่า) — dev ใช้ localhost:8443, prod ใส่โดเมน Vercel
FRONTEND_ORIGIN=http://localhost:8443

# โฟลเดอร์เก็บไฟล์อัปโหลด (รูปเมนู/โลโก้/QR/สลิป) — ไม่ตั้งค่านี้จะใช้ ./uploads (ข้าง process.cwd())
# บน Railway (หรือ container ที่ filesystem เป็น ephemeral) ต้องชี้ไปที่ mount path ของ volume จริง
# ไม่งั้นไฟล์ที่อัปโหลดไว้จะหายหมดทุกครั้งที่ redeploy
# UPLOADS_DIR=/data/uploads

# bootstrap super admin คนแรกของระบบ — อีเมลที่ใส่ไว้ที่นี่จะได้ role SUPER_ADMIN อัตโนมัติตอน login/sync
# ครั้งแรกที่สร้างบัญชี (เช็คเฉพาะตอนสร้างบัญชีใหม่เท่านั้น ถ้า login ไปแล้วก่อนหน้านี้ต้องโปรโมทเองผ่าน DB
# หรือให้ super admin คนอื่นตั้งให้ผ่านหน้า Super Admin แทน) คั่นด้วย , ได้หลายอีเมล ไม่สนตัวพิมพ์ใหญ่-เล็ก
# หลังจากมี super admin คนแรกแล้ว เพิ่มคนต่อไปได้เองจากในแอป ไม่ต้องพึ่งตัวแปรนี้อีก
# SUPER_ADMIN_EMAILS=you@example.com
