PORT=3000

# Railway จะ inject ให้อัตโนมัติถ้าใช้ Postgres plugin ในโปรเจกต์เดียวกัน
DATABASE_URL="postgresql://user:password@localhost:5432/catering?schema=public"

# ต้องสร้าง API ใน Auth0 ก่อน (Applications > APIs > Create API) แล้วเอา Identifier มาใส่ AUTH0_AUDIENCE
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.pipatphochana-catering.app

# origin ของ frontend (คั่นด้วย , ได้หลายค่า) — dev ใช้ localhost:8443, prod ใส่โดเมน Vercel
FRONTEND_ORIGIN=http://localhost:8443
